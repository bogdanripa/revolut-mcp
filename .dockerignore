# Dependencies and build output (reinstalled/rebuilt inside the image)
node_modules
dist
coverage

# VCS and CI
.git
.github
.gitignore
.gitattributes

# Tests and docs (not needed at runtime)
tests
docs
scripts
*.md

# The marketing site is published to the platform's CDN by CI, not served by
# the container — shipping it in the image would only make it go stale.
web

# Secrets and local config — never ship these into an image
.env
.env.*
!.env.sandbox.template
certs
*.pem
*.key
*.p12
*.pfx
.tokens.json

# Editor / OS noise
.idea
.vscode
.DS_Store
Thumbs.db
